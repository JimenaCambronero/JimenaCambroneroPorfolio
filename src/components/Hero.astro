---
import GitHubIcon from "./Icons/GitHubIcon.astro"
import LinkedInIcon from "./Icons/LinkedInIcon.astro"
import Social from "./Social.astro"
import CvIcon from "./Icons/CvIcon.astro"
import BookIcon from "./Icons/BookIcon.astro"
import CorreoIcon from "./Icons/CorreoIcon.astro"
import MicrophoneIcon from "./Icons/MicrophoneIcon.astro"
import YouTubeIcon from "./Icons/YouTubeIcon.astro"
const personalImageAlt = "Jimena Cambronero, Fabric Data Engineer"
---

<div class="max-w mx-auto">
  <div class="flex flex-col-reverse sm:flex-row gap-4 mb-4 items-center sm:items-start">

    <div class="sm:w-2/3">
      <h1 class="text-4xl font-bold tracking-tight text-gray-700 sm:text-5xl dark:text-white">
        Hola, soy Jimena 👩‍💻
      </h1>
      <p class="mt-4 text-lg text-gray-700 dark:text-gray-200 leading-relaxed">
        <strong class="text-yellow-500 font-semibold dark:text-yellow-400">Fabric Data Engineer · Business Intelligence Speaker · Community Builder</strong>
      </p>

      <nav class="flex flex-wrap gap-2 mt-6">
        <Social href="https://www.linkedin.com/in/jimenacambronero/">
          <LinkedInIcon class="size-4" />
          LinkedIn
        </Social>
        <Social href="https://github.com/JimenaCambronero">
          <GitHubIcon class="size-4" />
          GitHub
        </Social>
        <Social href="https://sessionize.com/Jimena-Cambronero/">
          <MicrophoneIcon class="size-4" />
          Sessionize
        </Social>
        <Social href="https://drive.google.com/file/d/1vVaeI4iIgXmFMMOaZPk4mutTejGJ5t-2/view?usp=share_link">
          <CvIcon class="size-4" />
          Ver CV
        </Social>
        <Social href="mailto:jimenacambronero@gmail.com">
          <CorreoIcon class="size-4" />
          Contactar
        </Social>
      </nav>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/blog"
          class="px-5 py-2.5 text-sm bg-yellow-500 hover:bg-yellow-600 dark:bg-yellow-600 dark:hover:bg-yellow-700 text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 inline-flex items-center gap-2"
        >
          <BookIcon class="size-4" />
          Lee mi Blog
        </a>
        <a
          href="https://www.youtube.com/@jimenacambronero"
          target="_blank"
          rel="noopener"
          class="px-5 py-2.5 text-sm bg-red-600 hover:bg-red-700 dark:bg-red-700 dark:hover:bg-red-800 text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 inline-flex items-center gap-2"
        >
          <YouTubeIcon class="size-4" />
          Conoce mi canal de YouTube
        </a>
      </div>

    </div>

    <!-- Imagen -->
    <div class="sm:w-1/3 sm:justify-end">
      <img
        class="rounded-full shadow-lg w-24 h-24 sm:w-48 sm:h-48"
        src="/foto/me.png"
        alt={personalImageAlt}
        width="192"
        height="192"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</div>
