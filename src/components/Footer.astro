---
import LinkedInIcon from "./Icons/LinkedInIcon.astro"
import GitHubIcon from "./Icons/GitHubIcon.astro"
import CorreoIcon from "./Icons/CorreoIcon.astro"

const currentYear = new Date().getFullYear()

const socialLinks = [
  {
    name: "LinkedIn",
    url: "https://www.linkedin.com/in/jimenacambronero/",
    icon: LinkedInIcon,
  },
  {
    name: "GitHub",
    url: "https://github.com/JimenaCambronero",
    icon: GitHubIcon,
  },
  {
    name: "Email",
    url: "mailto:jimenacambronero@gmail.com",
    icon: CorreoIcon,
  },
]

const navLinks = [
  { name: "Experiencia", url: "/#experiencia" },
  { name: "Proyectos", url: "/#proyectos" },
  { name: "Sobre mí", url: "/#sobre-mi" },
  { name: "Habilidades", url: "/#habilidades" },
  { name: "Formación", url: "/#formacion" },
]
---

<footer class="bg-gray-900 dark:bg-gray-950 text-gray-300 py-12 mt-24">
  <div class="container mx-auto px-4 max-w-6xl">
    <!-- Top section -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <!-- About -->
      <div>
        <h3 class="text-yellow-400 font-bold text-lg mb-4">Jimena Cambronero</h3>
        <p class="text-sm text-gray-400 leading-relaxed">
          Consultora de Data Analytics & BI especializada en Power BI, SQL y Python. Transformando datos en insights accionables.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-yellow-400 font-bold text-lg mb-4">Enlaces Rápidos</h3>
        <ul class="space-y-2">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.url}
                class="text-sm text-gray-400 hover:text-yellow-400 transition-colors duration-200"
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Social -->
      <div>
        <h3 class="text-yellow-400 font-bold text-lg mb-4">Conecta Conmigo</h3>
        <div class="flex gap-4">
          {socialLinks.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-400 hover:text-yellow-400 transition-colors duration-200"
              aria-label={social.name}
            >
              <social.icon class="size-6" />
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Divider -->
    <div class="border-t border-gray-800 my-8"></div>

    <!-- Bottom section -->
    <div class="flex flex-col md:flex-row justify-between items-center text-sm text-gray-500">
      <p class="mb-4 md:mb-0">
        © {currentYear} Jimena Cambronero. Todos los derechos reservados.
      </p>
      <p class="flex items-center gap-2">
        Hecho con
        <span class="text-yellow-400">❤️</span>
        en Madrid, España
      </p>
    </div>
  </div>
</footer>
