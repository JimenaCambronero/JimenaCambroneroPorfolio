---
import LinkedInIcon from "./Icons/LinkedInIcon.astro"
import GitHubIcon from "./Icons/GitHubIcon.astro"
import CorreoIcon from "./Icons/CorreoIcon.astro"
import YouTubeIcon from "./Icons/YouTubeIcon.astro"
import MicrophoneIcon from "./Icons/MicrophoneIcon.astro"

const currentYear = new Date().getFullYear()

const socialLinks = [
  {
    name: "LinkedIn",
    url: "https://www.linkedin.com/in/jimenacambronero/",
    icon: LinkedInIcon,
  },
  {
    name: "GitHub",
    url: "https://github.com/JimenaCambronero",
    icon: GitHubIcon,
  },
  {
    name: "YouTube",
    url: "https://www.youtube.com/@jimenacambronero",
    icon: YouTubeIcon,
  },
  {
    name: "Sessionize",
    url: "https://sessionize.com/Jimena-Cambronero/",
    icon: MicrophoneIcon,
  },
  {
    name: "Email",
    url: "mailto:jimenacambronero@gmail.com",
    icon: CorreoIcon,
  },
]

const navLinks = [
  { name: "Experiencia", url: "/#experiencia" },
  { name: "Proyectos", url: "/#proyectos" },
  { name: "Sobre mí", url: "/#sobre-mi" },
  { name: "Habilidades", url: "/#habilidades" },
  { name: "Certificaciones", url: "/#certificaciones" },
  { name: "Formación", url: "/#formacion" },
  { name: "Blog", url: "/blog" },
]
---

<footer class="bg-gray-900 dark:bg-gray-950 text-gray-300 py-8 mt-16">
  <div class="container mx-auto px-4 max-w-6xl">
    <!-- Top section -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
      <!-- About -->
      <div>
        <h3 class="text-yellow-400 font-bold text-base mb-3">Jimena Cambronero</h3>
        <p class="text-xs text-gray-400 leading-relaxed">
          Fabric Data Engineer y BI Consultant. Certificada DP-700 y DP-600. Speaker y Community Builder en la comunidad de datos.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-yellow-400 font-bold text-base mb-3">Enlaces Rápidos</h3>
        <ul class="grid grid-cols-2 gap-x-4 gap-y-1">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.url}
                class="text-xs text-gray-400 hover:text-yellow-400 transition-colors duration-200"
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Social -->
      <div>
        <h3 class="text-yellow-400 font-bold text-base mb-3">Conecta Conmigo</h3>
        <div class="flex gap-3">
          {socialLinks.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-400 hover:text-yellow-400 transition-colors duration-200"
              aria-label={social.name}
            >
              <social.icon class="size-5" />
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Divider -->
    <div class="border-t border-gray-800 my-5"></div>

    <!-- Bottom section -->
    <div class="flex flex-col md:flex-row justify-between items-center text-xs text-gray-500">
      <p class="mb-2 md:mb-0">
        © {currentYear} Jimena Cambronero. Todos los derechos reservados.
      </p>
      <p class="flex items-center gap-2">
        Hecho con
        <span class="text-yellow-400">❤️</span>
        en Madrid, España
      </p>
    </div>
  </div>
</footer>
