---
const SKILLS = {
  "Microsoft Fabric & Data Engineering": [
    "Data Pipelines",
    "Dataflows Gen2",
    "Notebooks",
    "Lakehouse",
    "Direct Lake",
    "Warehouse",
  ],
  "Business Intelligence & Analytics": [
    "Power BI",
    "DAX",
    "Power Query",
    "Tabular Editor",
    "DAX Studio",
  ],
  "Bases de Datos & Modelado": [
    "SQL",
    "Modelado dimensional",
    "Modelos semánticos",
  ],
  "Programación & Análisis": [
    "Python",
    "Google Sheets",
    "YouTube Analytics",
  ],
  "Desarrollo Web": [
    "HTML",
    "CSS",
    "React.js",
  ],
  "Comunidad & Herramientas": [
    "Public Speaking",
    "Community Building",
    "GitHub",
  ],
}
---

<div class="grid gap-3 md:gap-4 md:grid-cols-2">
  {
    Object.entries(SKILLS).map(([category, skills]) => (
      <div class="bg-white dark:bg-gray-900 rounded-lg shadow-md p-3 md:p-4">
        <h3 class="text-sm md:text-base font-bold text-yellow-500 mb-2">{category}</h3>
        <div class="flex flex-wrap gap-1.5">
          {skills.map((skill) => (
            <span class="px-2.5 py-0.5 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-200 rounded-full text-xs font-medium hover:bg-yellow-100 dark:hover:bg-yellow-900 hover:text-yellow-700 dark:hover:text-yellow-400 transition-colors duration-200">
              {skill}
            </span>
          ))}
        </div>
      </div>
    ))
  }
</div>
