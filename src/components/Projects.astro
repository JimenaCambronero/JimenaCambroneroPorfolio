    link: "https://cristiandel-giorgio.vercel.app",
    github: "https://github.com/JimenaCambronero/CristiandelGiorgio",
    image: "/projects/cdg.webp",
    tags: [TAGS.WEB],
  },

  {
    title: "E-Commerse Simon's Cat 🐱⁣ ",
    description: "Proyecto basado en un e-commerce de Simon´s Cat, un gato doméstico siempre hambriento usa diversas tácticas para lograr que su dueño lo alimente. el mismo fue Desarrollado aplicando React.js, React Router, Firebase y Tailwind. ",
    link: "https://proyecto-tienda-react.vercel.app",
    github: "https://github.com/JimenaCambronero/ProyectoTiendaReact",
    image: "/projects/simon.webp",
    tags: [TAGS.WEB],
  },

  {
    title: "Pagina Web - Cuidamos tu Mascota 🐱⁣ ",
    description: "El sitio web Cuidamos Tu Mascota es un proyecto diseñado para ofrecer servicios relacionados con el cuidado de mascotas, incluyendo información sobre cómo cuidar a las mascotas y posibles servicios de contacto para los dueños de animales. El proyecto se enfoca en proporcionar una interfaz amigable y útil para quienes buscan mejorar el bienestar de sus mascotas, presentando contenidos educativos y funcionales que facilitan la vida diaria de los dueños. El sitio está desarrollado con tecnologías modernas como HTML, CSS, JavaScript, y Bootstrap, lo que le permite ser accesible y funcional en diferentes dispositivos​.",
    link: "https://cuidamos-tu-mascota.vercel.app",
    github: "https://github.com/JimenaCambronero/CuidamosTuMascota",
    image: "/projects/mascota.webp",
    tags: [TAGS.WEB],
  },
]


---

<div class="flex flex-col gap-y-12 md:gap-y-16">
  {PROJECTS.map(({ image, title, description, tags, link, github }) => (
    <article class="bg-white dark:bg-gray-900 rounded-lg shadow-lg p-4 md:p-6 flex flex-col">
      <h3 class="text-xl md:text-2xl font-bold text-yellow-500 mb-2">{title}</h3>
      <ul class="flex flex-wrap mb-2 gap-x-2">
        {tags.map((tag) => (
          <li>
            <span class={`flex gap-x-2 rounded-full ${tag.class} py-2 px-4`}>
              <tag.icon class="size-4" />
              {tag.name}
            </span>
          </li>
        ))}
      </ul>
      <div class="mt-2 text-sm md:text-base text-gray-600 dark:text-gray-200 pb-4 md:pb-6">{description}</div>
      <img class="rounded shadow-2xl shadow-white/10 object-cover" src={image} alt={`Captura de pantalla del proyecto ${title}`} loading="lazy" decoding="async" width="1920" height="1080" />
      <footer class="flex items-center justify-start mt-4 gap-x-4">
        {github && (
          <LinkButton href={github} class="flex items-center gap-x-2">
            <GitHubIcon class="size-6" />
            Ver Código
          </LinkButton>
        )}
        {link && (
          <LinkButton href={link} class="flex items-center gap-x-2">
            <Link class="size-4" />
            Ver Proyecto
          </LinkButton>
        )}
      </footer>
    </article>
  ))}
</div>
