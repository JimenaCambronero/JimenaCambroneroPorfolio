    link: "https://app.powerbi.com/view?r=eyJrIjoiNTJlZmRiZTgtYzJhMy00YmEwLWFkY2EtMTRmM2VlODBmYzE1IiwidCI6ImRmODY3OWNkLWE4MGUtNDVkOC05OWFjLWM4M2VkN2ZmOTVhMCJ9",
