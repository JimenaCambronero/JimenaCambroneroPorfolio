---
import GitHubIcon from "./Icons/GitHubIcon.astro"
import SqlIcon from "./Icons/SqlIcon.astro"
import Link from "./Icons/Link.astro"
import LinkButton from "./LinkButton.astro"
import PythonIcon from "./Icons/PythonIcon.astro"
import PowerBiIcon from "./Icons/PowerBiIcon.astro"
import WebIcon from "./Icons/WebIcon.astro"

const TAGS = {
  PYTHON: {
    name: "Python",
    class: "bg-black text-white",
    icon: PythonIcon,
  },
  SQL: {
    name: "Sql",
    class: "bg-black  text-white",
    icon: SqlIcon,
  },
  POWERBI: {
    name: "Power Bi",
    class: "bg-black  text-white",
    icon: PowerBiIcon,
  },
  WEB: {
    name: "Página Web",
    class: "bg-black  text-white",
    icon: WebIcon,
  }
  
}

const PROJECTS = [
