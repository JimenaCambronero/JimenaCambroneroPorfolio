---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';

export const getStaticPaths = (async () => {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await entry.render();

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('es-ES', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(date);
};
---

<Layout
  title={`${entry.data.title} | Jimena Cambronero`}
  description={entry.data.description}
  type="article"
  publishedDate={entry.data.pubDate}
  articleAuthor={entry.data.author}
  image={entry.data.image}
>
  <main class="container mx-auto px-4 py-8 md:py-16 max-w-4xl">
    <!-- Breadcrumb -->
    <nav class="mb-6 md:mb-8 text-xs md:text-sm flex flex-wrap items-center">
      <a href="/" class="text-yellow-500 hover:text-yellow-600 dark:text-yellow-400 dark:hover:text-yellow-300">
        Inicio
      </a>
      <span class="mx-1 md:mx-2 text-gray-400">/</span>
      <a href="/blog" class="text-yellow-500 hover:text-yellow-600 dark:text-yellow-400 dark:hover:text-yellow-300">
        Mininotas
      </a>
      <span class="mx-1 md:mx-2 text-gray-400">/</span>
      <span class="text-gray-600 dark:text-gray-300">
        {entry.data.title}
      </span>
    </nav>

    <!-- Article Header -->
    <article class="prose prose-base md:prose-lg dark:prose-invert max-w-none">
      <header class="mb-6 md:mb-8 pb-6 md:pb-8 border-b border-gray-200 dark:border-gray-700">
        <h1 class="text-2xl md:text-4xl font-bold text-gray-800 dark:text-white mb-4 leading-tight">
          {entry.data.title}
        </h1>

        <p class="text-base md:text-xl text-gray-600 dark:text-gray-300 mb-4 md:mb-6">
          {entry.data.description}
        </p>

        <div class="flex flex-wrap items-center gap-3 md:gap-4 text-xs md:text-sm text-gray-500 dark:text-gray-400">
          <div class="flex items-center gap-1.5 md:gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 md:h-5 md:w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
            </svg>
            <span>{entry.data.author}</span>
          </div>

          <div class="flex items-center gap-1.5 md:gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 md:h-5 md:w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
            </svg>
            <time datetime={entry.data.pubDate.toISOString()}>
              {formatDate(entry.data.pubDate)}
            </time>
          </div>
        </div>

        {entry.data.tags && entry.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-4 md:mt-6">
            {entry.data.tags.map((tag) => (
              <span class="px-2.5 md:px-3 py-1 bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-400 text-xs md:text-sm font-medium rounded-full">
                {tag}
              </span>
            ))}
          </div>
        )}
      </header>

      <!-- Article Content -->
      <div class="prose-headings:text-gray-800 dark:prose-headings:text-white prose-p:text-gray-600 dark:prose-p:text-gray-300 prose-strong:text-gray-800 dark:prose-strong:text-white prose-a:text-yellow-500 dark:prose-a:text-yellow-400 prose-code:text-yellow-600 dark:prose-code:text-yellow-400">
        <Content />
      </div>

      <!-- Share Buttons -->
      <div class="mt-8 md:mt-12 pt-6 md:pt-8 border-t border-gray-200 dark:border-gray-700">
        <p class="text-sm md:text-base font-semibold text-gray-700 dark:text-gray-300 mb-4">
          Compartir este artículo:
        </p>
        <div class="flex flex-wrap gap-3">
          <!-- Copy Link Button -->
          <button
            id="copy-link-btn"
            class="inline-flex items-center gap-2 px-4 py-2 bg-yellow-500 hover:bg-yellow-600 text-white rounded-lg font-medium transition-colors text-sm md:text-base"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
            <span id="copy-text">Copiar enlace</span>
          </button>
        </div>
      </div>

      <!-- Author Section -->
      <div class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-700">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-4">Sobre la autora</h3>
        <div class="flex flex-col items-center md:items-start md:flex-row gap-6 mb-8 p-6 bg-gray-50 dark:bg-gray-900 rounded-lg">
          <div class="flex-shrink-0">
            <img
              width="120"
              height="120"
              src="/foto/me.png"
              alt={entry.data.author}
              class="w-32 h-32 object-cover rounded-full transition-transform duration-300 transform hover:scale-105"
            />
          </div>
          <div class="flex flex-col justify-center">
            <p class="text-lg font-semibold text-gray-800 dark:text-white mb-2">
              {entry.data.author}
            </p>
            <p class="text-gray-600 dark:text-gray-300 text-sm md:text-base max-w-md">
              Consultora de Data Analytics especializada en Power BI y Microsoft Fabric. Apasionada por los datos, el análisis y compartir conocimiento con la comunidad.
            </p>
          </div>
        </div>
      </div>

      <!-- Back to Blog -->
      <div>
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-yellow-500 hover:text-yellow-600 dark:text-yellow-400 dark:hover:text-yellow-300 font-semibold transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
          </svg>
          Volver a Mininotas
        </a>
      </div>
    </article>
  </main>
</Layout>

<style is:global>
  /* Mejoras tipográficas para el contenido del blog */
  .prose {
    @apply text-gray-600 dark:text-gray-300;
  }

  .prose h2 {
    @apply text-xl md:text-2xl font-bold mt-6 md:mt-8 mb-3 md:mb-4 text-gray-800 dark:text-white;
  }

  .prose h3 {
    @apply text-lg md:text-xl font-bold mt-4 md:mt-6 mb-2 md:mb-3 text-gray-800 dark:text-white;
  }

  .prose ul, .prose ol {
    @apply my-4 ml-6;
  }

  .prose li {
    @apply mb-2;
  }

  .prose code {
    @apply bg-gray-100 dark:bg-gray-800 px-1.5 py-0.5 rounded text-sm;
  }

  .prose pre {
    @apply bg-gray-100 dark:bg-gray-800 p-4 rounded-lg overflow-x-auto;
  }

  .prose blockquote {
    @apply border-l-4 border-yellow-500 pl-4 italic text-gray-600 dark:text-gray-400;
  }

  .prose hr {
    @apply border-gray-200 dark:border-gray-700 my-8;
  }
</style>

<script>
  // Copy Link Button
  document.getElementById('copy-link-btn')?.addEventListener('click', async () => {
    const url = window.location.href;
    const copyText = document.getElementById('copy-text');

    try {
      await navigator.clipboard.writeText(url);
      if (copyText) {
        copyText.textContent = '¡Copiado!';
        setTimeout(() => {
          copyText.textContent = 'Copiar enlace';
        }, 2000);
      }
    } catch (err) {
      console.error('Error al copiar:', err);
    }
  });
</script>
